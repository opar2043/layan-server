# Copy to .env and fill in. Never commit the real .env.

# --- Database ---
MONGODB_URI=mongodb://localhost:27017
DB_NAME=layan

# --- Server ---
PORT=3000
# Comma-separated origins, or leave unset to allow all.
CORS_ORIGIN=

# --- Auth ---
# REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=604800

# --- Scheduler ---
# The in-process nightly loop. Set to false on serverless, where the same jobs
# are triggered with POST /api/jobs/run instead.
SCHEDULER_ENABLED=true
# REQUIRED for POST /api/jobs/run. The endpoint fails closed when this is unset.
CRON_SECRET=
SCORE_CRON_HOUR=3

# --- Booking rules ---
DEFAULT_LEAD_TIME_MINUTES=60
DEFAULT_MAX_ADVANCE_DAYS=60
DEFAULT_HORIZON_DAYS=14
FRAGMENTATION_THRESHOLD_MINUTES=15
INSTANT_SLOT_WINDOW_HOURS=3

# --- Fraud thresholds ---
CHARGEBACK_WINDOW_DAYS=90
CHARGEBACK_THRESHOLD=3
SAME_DAY_CANCEL_WINDOW_DAYS=7
SAME_DAY_CANCEL_THRESHOLD=3

# --- Rebooking ---
REBOOK_GRACE_DAYS=3

# --- Seeding ---
# npm run seed reads this file. The demo password is hard-coded in the seed
# script (12345678) and every seeded user gets a real bcrypt hash of it.
SEED_FILE=data.json
